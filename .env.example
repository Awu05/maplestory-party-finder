PORT=3000
DATABASE_URL=postgresql://pf:pf@localhost:5432/partyfinder
SESSION_SECRET=change-me-to-a-random-string-of-32-chars-or-more
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
WEB_ORIGIN=http://localhost:5173
# Reverse proxies allowed to set X-Forwarded-For (for per-IP sign-in limits): false, true, a hop count, or
# comma-separated proxy IPs/CIDRs. Blank = proxies on this machine or a private network when WEB_ORIGIN is
# https://, otherwise false. Only use true or a hop count when the port can't be reached except through
# your proxy, or visitors can fake their address.
TRUST_PROXY=
ADMIN_DISCORD_IDS=
UPLOAD_DIR=./uploads

# Password-reset email. Leave all blank to disable. Use your provider's verified sender address.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to false to run no background jobs (webhook worker, daily sync) in this process, e.g. on a second instance. Default: true.
JOBS_ENABLED=true
