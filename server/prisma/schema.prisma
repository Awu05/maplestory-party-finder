generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorldType {
  heroic
  interactive
}

enum Experience {
  learning
  cleared
  can_carry
}

enum SyncStatus {
  ok
  stale
}

model User {
  id          String       @id @default(cuid())
  discordId   String       @unique
  username    String
  avatar      String?
  banned      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  characters  Character[]
  posts       Post[]
  postMembers PostMember[]
}

model World {
  id           Int          @id @default(autoincrement())
  nexonWorldId Int          @unique
  name         String
  worldType    WorldType
  /// Nexon ranking region this world belongs to (spec §13).
  region       String       @default("na")
  active       Boolean      @default(true)
  guilds       GuildWorld[]
  characters   Character[]
  posts        Post[]
}

model Guild {
  id         String       @id @default(cuid())
  name       String       @unique
  iconUrl    String?
  webhookUrl String?
  active     Boolean      @default(true)
  worlds     GuildWorld[]
  characters Character[]
  posts      Post[]
}

model GuildWorld {
  guildId String
  worldId Int
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  world   World  @relation(fields: [worldId], references: [id])

  @@id([guildId, worldId])
}

model Boss {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  imageUrl     String?
  sortOrder    Int              @default(0)
  difficulties BossDifficulty[]
}

model BossDifficulty {
  id         Int             @id @default(autoincrement())
  bossId     Int
  boss       Boss            @relation(fields: [bossId], references: [id], onDelete: Cascade)
  difficulty String
  partyCap   Int             @default(6)
  sortOrder  Int             @default(0)
  characters CharacterBoss[]
  posts      PostBoss[]

  @@unique([bossId, difficulty])
}

model Character {
  id                     String          @id @default(cuid())
  ownerId                String
  owner                  User            @relation(fields: [ownerId], references: [id])
  ign                    String
  ignLower               String
  worldId                Int
  world                  World           @relation(fields: [worldId], references: [id])
  jobName                String
  level                  Int
  imageUrl               String
  combatPower            BigInt
  cpUpdatedAt            DateTime
  guildId                String
  guild                  Guild           @relation(fields: [guildId], references: [id])
  screenshotKey          String?
  note                   String          @default("")
  playTimes              Int[]           @default([])
  lastSyncedAt           DateTime
  syncStatus             SyncStatus      @default(ok)
  lastRefreshRequestedAt DateTime?
  createdAt              DateTime        @default(now())
  bosses                 CharacterBoss[]
  posted                 Post[]          @relation("PostPoster")
  memberships            PostMember[]
  requests               Request[]

  @@unique([ignLower, worldId])
}

model CharacterBoss {
  characterId      String
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  bossDifficultyId Int
  bossDifficulty   BossDifficulty @relation(fields: [bossDifficultyId], references: [id])
  experience       Experience

  @@id([characterId, bossDifficultyId])
}

model RarityTier {
  id        Int    @id @default(autoincrement())
  name      String @unique
  minCp     BigInt
  sortOrder Int
}

enum PostType {
  lfp
  recruiting
}

enum PostStatus {
  open
  full
  closed
}

enum RequestKind {
  join_request
  invite
}

enum RequestStatus {
  pending
  accepted
  declined
  cancelled
}

enum MemberRole {
  poster
  member
}

model Post {
  id                String       @id @default(cuid())
  type              PostType
  posterUserId      String
  posterUser        User         @relation(fields: [posterUserId], references: [id])
  posterCharacterId String?
  posterCharacter   Character?   @relation("PostPoster", fields: [posterCharacterId], references: [id], onDelete: SetNull)
  worldId           Int
  world             World        @relation(fields: [worldId], references: [id])
  guildId           String
  guild             Guild        @relation(fields: [guildId], references: [id])
  scheduledAt       DateTime?
  expiresAt         DateTime
  partySize         Int?
  minCp             BigInt?
  note              String       @default("")
  status            PostStatus   @default(open)
  /// manual | full | lfp_matched | character_deleted
  closedReason      String?
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  bosses            PostBoss[]
  members           PostMember[]
  requests          Request[]    @relation("RequestPost")
  lfpInvites        Request[]    @relation("RequestLfpPost")

  @@index([status, expiresAt])
}

model PostBoss {
  postId           String
  post             Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  bossDifficultyId Int
  bossDifficulty   BossDifficulty @relation(fields: [bossDifficultyId], references: [id])

  @@id([postId, bossDifficultyId])
}

model PostMember {
  id          String     @id @default(cuid())
  postId      String
  post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  role        MemberRole
  cpAtJoin    BigInt
  /// MemberSnapshot
  snapshot    Json
  joinedAt    DateTime   @default(now())

  @@unique([postId, characterId])
  @@index([userId])
}

model Request {
  id              String        @id @default(cuid())
  kind            RequestKind
  status          RequestStatus @default(pending)
  /// always the Recruiting post
  postId          String
  post            Post          @relation("RequestPost", fields: [postId], references: [id], onDelete: Cascade)
  /// applicant (join_request) or invitee (invite)
  characterId     String
  character       Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// invite only: the LFP post the invite answers
  lfpPostId       String?
  lfpPost         Post?         @relation("RequestLfpPost", fields: [lfpPostId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdAt       DateTime      @default(now())
  decidedAt       DateTime?

  @@index([characterId, status])
}
