generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorldType {
  heroic
  interactive
}

enum Archetype {
  warrior
  magician
  bowman
  thief
  pirate
  xenon
  unknown
}

enum SyncStatus {
  ok
  stale
}

model User {
  id            String         @id @default(cuid())
  discordId     String?        @unique
  typedDiscordId String?       @unique
  username      String
  /// Lower-cased username: this account's current claim on that name (null = no claim). Unique, case-insensitive.
  usernameKey   String?        @unique
  displayName   String?
  avatar        String?
  banned        Boolean        @default(false)
  /// Soft delete: the account can't sign in and is hidden, but nothing is destroyed. Cleared by reactivation.
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  sessionVersion Int          @default(0)
  characters    Character[]
  posts         Post[]
  postMembers   PostMember[]
  notifications Notification[]
  passkeys      Passkey[]
  passwordCredential PasswordCredential?
  passwordResetToken PasswordResetToken?
}

model PasswordResetToken {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique
  sessionVersion Int
  expiresAt      DateTime

  @@index([expiresAt])
}

model PasswordCredential {
  userId       String @id
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String @unique
  passwordHash String
}

model Passkey {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey  Bytes
  counter    BigInt   @default(0)
  deviceType String
  backedUp   Boolean
  transports String[] @default([])
  createdAt  DateTime @default(now())

  @@index([userId])
}

model PasskeyChallenge {
  id          String   @id
  challenge   String
  purpose     String
  userId      String?
  username    String?
  displayName String?
  typedDiscordId String?
  expiresAt   DateTime

  @@index([expiresAt])
}

model World {
  id           Int          @id @default(autoincrement())
  nexonWorldId Int          @unique
  name         String
  worldType    WorldType
  /// Nexon ranking region this world belongs to (spec §13).
  region       String       @default("na")
  active       Boolean      @default(true)
  guilds       GuildWorld[]
  characters   Character[]
  posts        Post[]
}

model Guild {
  id                String            @id @default(cuid())
  name              String            @unique
  iconUrl           String?
  webhookUrl        String?
  partyForumWebhookUrl String?
  bossRoleIds       Json              @default("{}")
  active            Boolean           @default(true)
  worlds            GuildWorld[]
  characters        Character[]
  posts             Post[] @relation("PostGuild")
  notificationPosts Post[] @relation("PostNotificationGuild")
  partyForumPosts   Post[] @relation("PostPartyForumGuild")
  webhookDeliveries WebhookDelivery[]
}

model GuildWorld {
  guildId String
  worldId Int
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  world   World  @relation(fields: [worldId], references: [id])

  @@id([guildId, worldId])
}

model Boss {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  imageUrl     String?
  sortOrder    Int              @default(0)
  difficulties BossDifficulty[]
}

model BossDifficulty {
  id         Int             @id @default(autoincrement())
  bossId     Int
  boss       Boss            @relation(fields: [bossId], references: [id], onDelete: Cascade)
  difficulty String
  partyCap   Int             @default(6)
  sortOrder  Int             @default(0)
  posts      PostBoss[]

  @@unique([bossId, difficulty])
}

model Character {
  id                     String          @id @default(cuid())
  ownerId                String
  owner                  User            @relation(fields: [ownerId], references: [id])
  ign                    String
  ignLower               String
  worldId                Int
  world                  World           @relation(fields: [worldId], references: [id])
  jobName                String
  archetype              Archetype       @default(unknown)
  level                  Int
  imageUrl               String
  combatPower            BigInt
  cpUpdatedAt            DateTime
  guildId                String?
  guild                  Guild?          @relation(fields: [guildId], references: [id])
  source                 CharacterSource @default(nexon)
  screenshotKey          String?
  lastSyncedAt           DateTime
  syncStatus             SyncStatus      @default(ok)
  lastRefreshRequestedAt DateTime?
  createdAt              DateTime        @default(now())
  posted                 Post[]          @relation("PostPoster")
  memberships            PostMember[]
  requests               Request[]

  @@unique([ignLower, worldId])
}

enum CharacterSource {
  nexon
  manual
}

model RarityTier {
  id        Int    @id @default(autoincrement())
  name      String @unique
  minCp     BigInt
  sortOrder Int
}

enum PostType {
  lfp
  recruiting
  carrying
}

enum PostStatus {
  open
  full
  closed
}

enum RequestKind {
  join_request
  invite
}

enum RequestStatus {
  pending
  accepted
  declined
  cancelled
}

enum MemberRole {
  poster
  member
}

model Post {
  id                String       @id @default(cuid())
  type              PostType
  posterUserId      String
  posterUser        User         @relation(fields: [posterUserId], references: [id])
  posterCharacterId String?
  posterCharacter   Character?   @relation("PostPoster", fields: [posterCharacterId], references: [id], onDelete: SetNull)
  worldId           Int
  world             World        @relation(fields: [worldId], references: [id])
  guildId           String?
  guild             Guild?       @relation("PostGuild", fields: [guildId], references: [id], onDelete: SetNull)
  notificationGuildId String?
  notificationGuild Guild?       @relation("PostNotificationGuild", fields: [notificationGuildId], references: [id], onDelete: SetNull)
  partyForumGuildId String?
  partyForumGuild  Guild?        @relation("PostPartyForumGuild", fields: [partyForumGuildId], references: [id], onDelete: SetNull)
  /// The final time; null until the poster finalizes it.
  scheduledAt       DateTime?
  weeklyTimeZone    String?
  weeklyAnchorAt    DateTime?
  /// One forum thread is requested for this party, even if its time changes.
  forumThreadRequested Boolean @default(false)
  partyThreadId String?
  reminderOffsets Int[] @default([])
  remindersSent PostReminderSent[]
  /// Guilds whose channel received this run's announcement and has not had its closure notice yet.
  announcedGuildIds String[]     @default([])
  /// The "finalized" closure notice has gone out for this run (reset when the post is reopened).
  finalizedNoticeSent Boolean   @default(false)
  /// Last manually requested Discord announcement; creation starts the first cooldown.
  lastDiscordAnnouncementAt DateTime?
  /// Half-hour slots (day * 48 + slot, 0 = Sunday) in freeTimesZone.
  freeTimes         Int[]        @default([])
  /// IANA zone of freeTimes; null when freeTimes is empty.
  freeTimesZone     String?
  expiresAt         DateTime
  partySize         Int?
  minCp             BigInt?
  /// The poster's own title, used for the Discord notification; empty means the default (type: bosses).
  title             String       @default("")
  note              String       @default("")
  status            PostStatus   @default(open)
  /// manual | finalized | full | lfp_matched | character_deleted
  closedReason      String?
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  bosses            PostBoss[]
  members           PostMember[]
  requests          Request[]    @relation("RequestPost")
  lfpInvites        Request[]    @relation("RequestLfpPost")

  @@index([status, expiresAt])
  @@index([weeklyTimeZone, scheduledAt])
}

model PostReminderSent {
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  offsetMinutes Int
  runAt DateTime
  sentAt DateTime @default(now())

  @@id([postId, offsetMinutes, runAt])
  @@index([runAt])
}

model PostBoss {
  postId           String
  post             Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  bossDifficultyId Int
  bossDifficulty   BossDifficulty @relation(fields: [bossDifficultyId], references: [id])

  @@id([postId, bossDifficultyId])
}

model PostMember {
  id          String     @id @default(cuid())
  postId      String
  post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  role        MemberRole
  cpAtJoin    BigInt
  /// MemberSnapshot
  snapshot    Json
  joinedAt    DateTime   @default(now())
  freeTimes   Int[]      @default([])
  freeTimesZone String?

  @@unique([postId, characterId])
  @@index([userId])
}

model Request {
  id              String        @id @default(cuid())
  kind            RequestKind
  status          RequestStatus @default(pending)
  /// always the Recruiting post
  postId          String
  post            Post          @relation("RequestPost", fields: [postId], references: [id], onDelete: Cascade)
  /// applicant (join_request) or invitee (invite)
  characterId     String
  character       Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// invite only: the LFP post the invite answers
  lfpPostId       String?
  lfpPost         Post?         @relation("RequestLfpPost", fields: [lfpPostId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdAt       DateTime      @default(now())
  decidedAt       DateTime?

  @@index([characterId, status])
}

enum DeliveryStatus {
  pending
  sent
  failed
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// join_request | invite | accepted | declined | auto_declined | removed | member_left | time_set | reminder
  kind      String
  text      String
  /// app-relative path, e.g. /posts/abc
  link      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt, createdAt])
}

model WebhookDelivery {
  id            String         @id @default(cuid())
  guildId       String
  guild         Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  /// post.created | request.created | request.accepted | test
  eventType     String
  /// set for post.created so the worker can skip posts banned or deleted before delivery
  postId        String?
  /// full Discord execute-webhook body
  payload       Json
  status        DeliveryStatus @default(pending)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  createdAt     DateTime       @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([guildId, createdAt])
}

model JobRun {
  name       String   @id
  lastRunAt  DateTime
  lastResult Json?
}

model JobClass {
  id        Int       @id @default(autoincrement())
  name      String
  nameLower String    @unique
  archetype Archetype
  category  String    @default("Other")
}
